# Server env file. Copy to <repo>/.env on the server (cp deploy/.env.example .env; chmod 600 .env).
# Placeholders only. Never commit the real file.
# docker-compose.yml uses env_file .env (every var below reaches the iris container) plus an explicit
# environment list. DEMO_* / ACME_* / DEMO_AUTH are read by the compose overlay and Caddy only.
IOA_LIVE=1
IOA_MAX_USD=0.50
IOA_DAILY_RESET=1
LLM_PROFILE=openai
LLM_MODEL=
LLM_PRICE_IN_PER_M=0.75
LLM_PRICE_OUT_PER_M=4.50
OPENAI_API_KEY=
OPENROUTER_API_KEY=
REPLAY=
IOA_RECORD=0
IOA_AUTOAPPROVE=1
IOA_REVIEWER_USER=reviewer
IOA_REVIEWER_PASSWORD=change-me
# Optional: IOA_CASES_IN, IOA_REPLAY_DIR (defaults are set in docker-compose.yml)

DEMO_DOMAIN=demo.example.com
ACME_EMAIL=you@example.com
# Basic auth is off unless DEMO_AUTH=auth_on
DEMO_AUTH=auth_off
DEMO_BASIC_AUTH_USER=judge
# Single-quote the bcrypt hash so compose does not interpolate its $ signs, e.g. DEMO_BASIC_AUTH_HASH='$2a$14$...'
DEMO_BASIC_AUTH_HASH=
