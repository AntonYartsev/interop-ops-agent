# Host port bindings (container ports: 1972, 52773, 8080)
IRIS_PORT_SUPER=51272
IRIS_PORT_WEB=52273
IRIS_PORT_AUX=52280

# LLM Profile: "openai" (default) or "openrouter"
LLM_PROFILE=openai
# Empty means profile default (openai: gpt-5.4-mini, fallback gpt-4.1-mini; openrouter: google/gemini-2.5-flash)
LLM_MODEL=

# API keys (leave empty for deterministic REPLAY mode)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Replay / Record / Live opt-in & container paths
# LIVE mode is opt-in: requires active API key AND IOA_LIVE=1 (or runtime SetLive(1))
# Set REPLAY=1 to force REPLAY mode even when an API key and IOA_LIVE=1 are present
IOA_LIVE=0
REPLAY=
IOA_RECORD=0
IOA_CASES_IN=/irisdev/app/cases/in/
IOA_REPLAY_DIR=/irisdev/app/replay

# Workflow Inbox reviewer login (role: IOA-Reviewers)
# Auto-approve pending_review decisions (Source=human:auto). demo.sh sets 1 by default, --manual sets 0.
IOA_AUTOAPPROVE=0
# Daily reset of the LIVE call counter ^IOA.Budget at 00:00 UTC (Task Manager task, installed on run.sh/Reload
# only when 1; not installed by default). Remove: do ##class(InteropOps.Setup).UninstallDailyReset()
IOA_DAILY_RESET=0
IOA_REVIEWER_USER=reviewer
IOA_REVIEWER_PASSWORD=change-me
