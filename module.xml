<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="interop-ops-agent.ZPM">
    <Module>
      <Name>interop-ops-agent</Name>
      <Version>0.2.0</Version>
      <Description>HL7 v2 lab-feed triage agent on InterSystems IRIS AI Hub (EAP): Interoperability production, deterministic gate, Workflow review, REPLAY cassettes, judge demo page /demo/. Synthetic data only.</Description>
      <Keywords>interoperability hl7 ai-hub agent workflow vector-search</Keywords>
      <Author>
        <Person>Anton Yartsev</Person>
        <CopyrightDate>2026</CopyrightDate>
        <License>MIT</License>
      </Author>
      <Packaging>module</Packaging>
      <!-- Tested only on IRIS 2027.1.0AI build 109 (ARM64 and x64) and 2026.3.0AI build 154, with IPM 0.10.10 (AI Hub EAP: %AI.Agent, %AI.Provider).
           The AI Hub requirement itself cannot be expressed here. -->
      <SystemRequirements Version=">=2026.3" Interoperability="enabled"/>
      <SourcesRoot>src</SourcesRoot>
      <!-- src/InteropOps/**.cls. The evidence step and the production use the PEX message classes
           PexHl7.* (pex/src/PexHl7), so that package is a resource too. The .NET DLLs are not:
           without the .NET runtime PexHl7Check soft-fails. -->
      <Resource Name="InteropOps.PKG"/>
      <Resource Name="PexHl7.PKG" Directory="../pex/src"/>
      <!-- FileCopy copies cases/, data/ and replay/ into dedicated install directory ${mgrdir}interop-ops-agent/.
           InteropOps.Util.Paths reads the repository mounts first (/irisdev/app/, then /home/irisowner/dev/), so the
           docker-compose dev flow and demo.sh stay unchanged, and uses ${mgrdir}interop-ops-agent/ when no repository is mounted.
           On uninstall, %File.RemoveDirectoryTree removes ${mgrdir}interop-ops-agent/.
           No WebApplication: /demo, its roles and the IOA.DemoWrite privileged routine application are created by
           Setup.EnsureDemoWebApp, which InitAndStartProduction calls. -->
      <FileCopy Name="cases/" Target="${mgrdir}interop-ops-agent/cases/"/>
      <FileCopy Name="data/" Target="${mgrdir}interop-ops-agent/data/"/>
      <FileCopy Name="replay/" Target="${mgrdir}interop-ops-agent/replay/"/>
      <Invoke Class="InteropOps.Setup" Method="InitAndStartProduction" Phase="Activate" When="After" CheckStatus="true">
        <Arg>${root}src</Arg>
      </Invoke>
      <Invoke Class="%File" Method="RemoveDirectoryTree" Phase="Clean" When="After" CheckStatus="false">
        <Arg>${mgrdir}interop-ops-agent</Arg>
      </Invoke>
      <AfterInstallMessage>interop-ops-agent: production InteropOps.Production started in namespace IRISAPP (REPLAY unless IOA_LIVE=1). Judge page: /demo/ . Demo run: ./scripts/demo.sh --replay (from the repository).</AfterInstallMessage>
    </Module>
  </Document>
</Export>
